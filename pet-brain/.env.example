# ==========================================
# Desktop Pet Brain Configuration & Secrets
# ==========================================

# Active AI Backend: 'local' (Ollama Qwen2.5-VL) or 'gemini' (Google Cloud Gemini API)
AI_BACKEND=local

# Google Gemini API Settings (Free API key from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=qwen2.5vl:7b
